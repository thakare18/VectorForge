# Local development example. Never commit real credentials.
NODE_ENV=development
PORT=3000
MONGODB_URI=
JWT_SECRET=
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:5173
# Production requires the exact public HTTPS backend origin.
BACKEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
# Configure all three fields per provider or leave all three empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Default preserves local SMTP. Render Free blocks ports 25/465/587.
# On Render Free select brevo, supply its API key (not SMTP key), and a verified sender.
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM=
# Required only when MAIL_PROVIDER=smtp; ignored in brevo mode.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
