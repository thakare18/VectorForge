# Local development example. Never commit real credentials.
NODE_ENV=development
PORT=3000
MONGODB_URI=
JWT_SECRET=
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:5173
# Production requires the exact public HTTPS backend origin.
BACKEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
# Configure all three fields per provider or leave all three empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Production local registration/reset requires a complete SMTP configuration.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
